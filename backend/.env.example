# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=pet_health_companion

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Security Configuration
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit the actual .env file to git
# 2. Generate a strong JWT_SECRET_KEY using: openssl rand -hex 32
# 3. Rotate your GEMINI_API_KEY regularly
# 4. In production, set ENVIRONMENT=production
# 5. Update CORS_ORIGINS to only include your production domains
# 6. Update ALLOWED_HOSTS to only include your production domains
